    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./**/*credentials*.json)",
      "Read(./**/*secrets*.json)",
      "Read(./**/*token*.json)",
      "Read(./**/secrets/**)"
    ]
