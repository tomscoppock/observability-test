# Copy this file to .env (which is gitignored) and fill in real values.
# All application configuration is centralised here so you can swap
# LLM providers, observability backends, and database settings without
# touching code.

# --- LLM Configuration ---
# Provider: openai | gemma | qwen (all use OpenAI-compatible completions API)
LLM_PROVIDER=openai
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# --- Embedding Configuration ---
# Used for RAG document embedding. Same OpenAI-compatible pattern.
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small

# --- SurrealDB ---
SURREAL_URL=http://surrealdb:8000
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=observability
SURREAL_DB=rag

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=rag-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev

# --- Splunk Observability Cloud ---
# Sign up at https://www.splunk.com/en_us/products/observability-cloud.html
# Free edition: full features, limited by hosts.
SPLUNK_ACCESS_TOKEN=
SPLUNK_REALM=us1
SPLUNK_INGEST_URL=https://ingest.us1.signalfx.com

# --- Azure Monitor (future) ---
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- MCP Services ---
YOU_COM_API_KEY=

# --- Board (project tracking) ---
BOARD_BASE_URL=https://github.com/ORG/REPO/blob/main
