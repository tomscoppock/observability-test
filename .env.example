# Copy this file to .env (which is gitignored) and fill in real values.
# All application configuration is centralised here so you can swap
# LLM providers, observability backends, and database settings without
# touching code.

# --- LLM Configuration ---
# Provider: openai | azure | gemma | qwen (all use OpenAI-compatible completions API)
LLM_PROVIDER=openai
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Number of previous conversation rounds (user+assistant pairs) to include
# in each LLM request for multi-turn context. 0 = no history (default).
# Each round adds ~2 messages to the prompt, increasing token usage.
CHAT_HISTORY_ROUNDS=5

# --- Embedding Configuration ---
# Used for RAG document embedding. Same OpenAI-compatible pattern.
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
# Output dimensions -- must match the MTREE index in db/schema.surql.
# Common values: 1536 (text-embedding-3-small), 3072 (text-embedding-3-large).
# Omit or leave empty to use the model's default dimensions.
EMBEDDING_DIMENSIONS=3072

# --- Azure OpenAI (alternative to standard OpenAI) ---
# Azure endpoints are auto-detected by URL pattern (.openai.azure.com
# or .cognitiveservices.azure.com).  Set the base URL to include the
# deployment name; the code appends /embeddings or /chat/completions.
#
# LLM_API_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
# LLM_API_KEY=<azure-api-key>
# LLM_MODEL=gpt-4o-mini
#
# EMBEDDING_API_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
# EMBEDDING_API_KEY=<azure-api-key>
# EMBEDDING_MODEL=text-embedding-3-large
#
# AZURE_API_VERSION=2024-10-21

# --- SurrealDB ---
# Default: SurrealMX in-memory engine with async append-only logging
# and periodic snapshots (see docker-compose.yml command).
# Data persists across restarts via the surreal-data Docker volume.
#
# Storage options (set in docker-compose.yml command):
#   mem:///data/srdb?aol=async&sync=5s&snapshot=60s  (default -- in-memory + AOL + snapshots)
#   mem:///data/srdb?aol=sync&sync=every             (sync AOL -- survives process + system crash)
#   surrealkv:/data/srdb.db                          (SurrealKV -- SurrealDB's native KV engine)
#
# For SurrealDB Cloud, set the URL to your cloud instance:
#   SURREAL_URL=wss://YOUR-INSTANCE.surreal.cloud/rpc
#   SURREAL_USER=your-cloud-user
#   SURREAL_PASS=your-cloud-pass
SURREAL_URL=http://surrealdb:8000
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=observability
SURREAL_DB=rag

# SurrealDB built-in telemetry (set in docker-compose.yml):
#   SURREAL_TELEMETRY_PROVIDER=otlp  -- pushes surrealdb.* metrics, traces, logs
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317  -- OTLP gRPC
#   See: https://surrealdb.com/docs/manage/observability/configuration

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=rag-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev

# ---------- Observability backend selection ----------
# Which collector config to mount. Chooses where telemetry goes.
#   ./otel-collector-config.yaml               Splunk only, upstream contrib (default)
#   ./otel-collector-config.splunk-distro.yaml  Splunk only, Splunk Distribution image
#   ./otel-collector-config.azure.yaml          Azure Monitor only
#   ./otel-collector-config.dual.yaml           both, in parallel
OTEL_COLLECTOR_CONFIG=./otel-collector-config.yaml

# ---------- Collector image selection ----------
# Which OTel Collector image to run. The upstream community collector is
# the default for platform neutrality.
#
#   otel/opentelemetry-collector-contrib:latest           upstream (default)
#   quay.io/signalfx/splunk-otel-collector:latest         Splunk Distribution
#
# WARNING: The Splunk Distribution does NOT include gen_ai_normalizer
# (processor) or azure_monitor (exporter). If you switch to the Splunk
# image, you must remove gen_ai_normalizer from both the processors
# block and the traces pipeline in otel-collector-config.yaml, or the
# collector will crash on startup. The dual config also requires
# azure_monitor, so it cannot run on the Splunk Distribution at all.
# OTEL_COLLECTOR_IMAGE=quay.io/signalfx/splunk-otel-collector:latest

# ---------- LLM prompt / response content capture ----------
# Captures the actual prompt and answer text as span attributes.
#
# OFF BY DEFAULT, and it must stay off outside a test system. Prompts and
# responses routinely contain names, account numbers, customer data and
# proprietary business logic. Enabling this sends all of it to whichever
# observability backend the collector is pointed at.
#
# Why you would ever turn it on: Splunk's AI Agent Monitoring
# (APM > AI trace data, AI Interactions) and its platform-side evaluations
# read this content. Without it those screens stay empty. It is NOT
# licence-gated; content capture is the only thing standing between you and
# a populated AI trace view.
#
# Accepted values:
#   false      (default) no content leaves the application
#   SPAN_ONLY  content on the span. The value Splunk's setup guide specifies
#   true / 1   accepted as equivalent to SPAN_ONLY
#   EVENT_ONLY deliberately NOT honoured. It asks for content as separate
#              log events, which this service does not emit, so honouring it
#              would put content somewhere you did not ask for it
#   anything else falls back to off rather than guessing
#
# Content is capped at 8192 characters per attribute and marked with
# gen_ai.capture.truncated=true when clipped.
#
# Compose reads this at container creation, so a change needs
# "docker compose up -d --build api", not a restart.
#
# The variable name is the OpenTelemetry standard one. Nothing reads it
# automatically here (GenAI auto-instrumentation exists for Python, not for
# this hand-instrumented Node service), so api/src/genai-content.js
# implements it directly and honours the standard name for portability.
#
# Read docs/splunk-setup.md section 28 before enabling this anywhere real.
# If you enable it against real traffic, mask PII first.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false


# ---------- Azure Monitor ----------
# CREDENTIAL. Printed by scripts/setup-azure-monitor.*. Never commit.
# This CANNOT be rotated -- see the warning below.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Used by scripts/setup-azure-monitor.* and scripts/setup-azure-workbook.*
# Leave AZURE_SUBSCRIPTION_ID empty to use the az CLI's current subscription.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-observability-test
AZURE_LOCATION=uksouth
AZURE_APP_INSIGHTS_NAME=appi-rag-agent
AZURE_LOG_ANALYTICS_NAME=law-rag-agent

# Resource group tags. Both are REQUIRED -- the setup script refuses to
# run without them.
AZURE_TAG_PURPOSE=
AZURE_TAG_RESPONSIBLE_OWNER=


# --- Splunk: traces and metrics (Observability Cloud) ---
# Sign up at https://www.splunk.com/en_us/products/observability-cloud.html
# Free edition: full features, limited by hosts.
#
# Traces and metrics go to Splunk Observability Cloud (formerly SignalFx).
# Logs do NOT: see the Splunk Cloud Platform section below. Splunk
# deprecated native Log Observer (direct log ingest into Observability
# Cloud) in January 2024.
#
#   Traces  -> otlp_http/splunk  (OTLP/HTTP to Splunk APM)
#   Metrics -> signalfx          (native Splunk metrics format)
#
# The collector derives both of those endpoints from SPLUNK_REALM. Read
# your realm off your Observability Cloud URL: app.eu2.signalfx.com
# means eu2. 
SPLUNK_ACCESS_TOKEN=
SPLUNK_REALM=us1


# --- Splunk: logs (Cloud Platform / Enterprise, via HEC) ---
# Logs go to a Splunk Cloud Platform or Splunk Enterprise instance via
# the HTTP Event Collector (HEC). Observability Cloud can then read them
# in place via Log Observer Connect, which requires a LICENSED
# (non-trial) platform instance. See docs/splunk-setup.md.
#
#   Logs -> splunk_hec/logs  (HEC to Splunk Cloud Platform / Enterprise)
#
# Create a token in Splunk Web: Settings > Add Data > Monitor >
# HTTP Event Collector. The token value is shown only once, so copy it
# straight away. Leave "Enable indexer acknowledgement" UNCHECKED: when
# it is on, HEC requires an X-Splunk-Request-Channel header that the
# collector does not send, and every request fails with HTTP 400
# "Data channel is missing".
#
# Endpoint format. Splunk documents:
#   https://http-inputs-<stack>.splunkcloud.com/services/collector
# but on some trials that hostname is never provisioned in DNS. If it
# fails to resolve, HEC may instead be reachable on your main stack
# hostname at port 8088:
#   https://<stack>.splunkcloud.com:8088/services/collector
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=

# Target index for log events. Must appear in the token's "Allowed
# Indexes" list or HEC rejects events with HTTP 400 "Incorrect index".
# Avoid "history": that is Splunk's internal search-history index.
SPLUNK_HEC_INDEX=main

# Sourcetype applied to log events, used when searching in Splunk
# (e.g. index=main sourcetype=otel).
SPLUNK_HEC_SOURCETYPE=otel

# Set true ONLY when the HEC endpoint serves Splunk's default self-signed
# certificate (CN=SplunkServerDefaultCert), which is what an
# unprovisioned trial's port 8088 presents. NEVER set true against a
# production instance: provision a real certificate there instead.
SPLUNK_HEC_INSECURE_SKIP_VERIFY=false

# Optional: override the deployment environment label sent with all telemetry
# OTEL_DEPLOYMENT_ENV=dev

# --- OpenTelemetry SDK diagnostics ---
# OTel SDK export failures are SILENT by default (its internal diag
# logger is a no-op). Set to debug or verbose to print SDK diagnostics to
# the api container's stdout when telemetry goes missing. This is how the
# BatchLogRecordProcessor bug in task 036 was finally found. Very noisy,
# so leave unset in normal use.
# OTEL_LOG_LEVEL=debug


# --- Azure Monitor (future) ---
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Admin ---
# Password required to access the Admin tab and /api/admin/* endpoints.
# If not set, admin features are disabled (endpoints return 503).
ADMIN_PASSWORD=

# --- MCP Services ---
YOU_COM_API_KEY=

# Playwright MCP server for web scraping into the knowledge base.
# The server runs separately (see Playwright-MCP-Demo repo).
# URL must include the /mcp path.
#
# Networking:
#   From Docker container to host machine:
#     MCP_PLAYWRIGHT_URL=http://host.docker.internal:8100/mcp
#   From Docker container to another container on the same Docker network:
#     MCP_PLAYWRIGHT_URL=http://playwright-mcp:8100/mcp
#   Running locally (not in Docker):
#     MCP_PLAYWRIGHT_URL=http://localhost:8100/mcp
#
# IMPORTANT: Do NOT use "localhost" when the API runs inside Docker --
# localhost inside a container refers to the container itself, not the host.
# Use "host.docker.internal" to reach services running on the host machine.
MCP_PLAYWRIGHT_URL=
MCP_PLAYWRIGHT_API_KEY=

# Connection retry settings (for resilience during server restarts):
#   MCP_CONNECT_RETRIES=3          -- max retry attempts (default 3)
#   MCP_CONNECT_RETRY_DELAY_MS=1000 -- initial delay in ms, doubles each retry (default 1000)

# --- Board (project tracking) ---
BOARD_BASE_URL=https://github.com/ORG/REPO/blob/main

